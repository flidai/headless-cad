{
  "schema_version": 1,
  "capabilities": [
    {
      "id": "machining.counterbore-fixture",
      "status": "experimental",
      "domain_ids": [
        "boolean.stepped_bore"
      ],
      "supported_domain": "Coaxial cylindrical through/blind drilling and opposed counterbores in the counterbored_fixture recipe: counterbore radius 6..8 mm, depth 4..8 mm, plate height 18..24 mm; native parameter sweep and independently imported assembly exchange at default/min/max configurations.",
      "exclusions": [
        "Noncoaxial intersecting bores",
        "Conical countersinks and general pockets",
        "Threads, fit, preload and load capacity certification",
        "General commercial CAD parity"
      ],
      "fixture": "examples/counterbored_fixture.star",
      "checks": [
        "native-moments",
        "exchange-moments"
      ],
      "kind": "engineering"
    },
    {
      "id": "machining.round-bearing-cartridge",
      "kind": "engineering",
      "status": "experimental",
      "domain_ids": [
        "boolean.round_stock",
        "boolean.blind_bore",
        "boolean.stepped_bore"
      ],
      "supported_domain": "Native annular stock with three blind spacer sockets and six counterbored mounting holes; mirrored bearing cartridge at bolt_pitch 40..44 mm, seat_depth 4..8 mm, flange_height 18..24 mm. Native 27-case sweep and independent default/min/max exchange checks.",
      "exclusions": [
        "General intersecting holes and pockets",
        "Conical countersinks",
        "Threads, fits, loads and bearing performance certification",
        "Manufacturing drawing release"
      ],
      "fixture": "examples/round_bearing_cartridge.star",
      "checks": [
        "round-native-moments",
        "round-exchange-moments"
      ]
    },
    {
      "id": "manufacturing.drive-module-release",
      "status": "planned",
      "domain_ids": [],
